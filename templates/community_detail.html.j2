{% extends "base.html.j2" %}
{% block content %}
{% autoescape true %}
<div class="col-md-8 mx-auto">
  <a href="{{ url_for('assignment1.communities') }}">All communities</a>
  <section class="card shadow-sm mt-3 mb-4">
    <div class="card-body">
      <p class="text-muted small">Public community</p>
      <h1 class="h2">{{ community.name }} {% if is_member %}<span class="badge bg-success">Member</span>{% endif %}</h1>
      <h2 class="h5 mt-3">Our shared purpose</h2>
      <p>{{ community.description }}</p>
      <p>{{ members|length }} members. Our community and its discussions continue as members come and go.</p>
      {% if session.get('user_id') %}
      <form method="POST" action="{{ url_for('assignment1.leave_community' if is_member else 'assignment1.join_community', community_id=community.id) }}">
        <button type="submit" class="btn {% if is_member %}btn-light{% else %}btn-primary{% endif %}">{% if is_member %}Leave community{% else %}Join community{% endif %}</button>
      </form>
      {% else %}
      <a href="{{ url_for('login') }}" class="btn btn-primary">Log in to join</a>
      {% endif %}
      <details class="mt-3">
        <summary>Community members ({{ members|length }})</summary>
        <ul class="mt-2">
          {% for member in members %}
          <li><a href="{{ url_for('user_profile', username=member.username) }}">@{{ member.username }}</a></li>
          {% else %}
          <li>No members yet. Be the first to join.</li>
          {% endfor %}
        </ul>
      </details>
    </div>
  </section>

  {% if is_member %}
  <section class="card shadow-sm mb-4">
    <div class="card-body">
      <h2 class="h4">Post to {{ community.name }}</h2>
      <p>Ask a question or share something that supports our shared purpose.</p>
      <form method="POST" action="{{ url_for('assignment1.add_community_post', community_id=community.id) }}">
        <label for="community-post-content" class="form-label">Your post</label>
        <textarea id="community-post-content" name="content" rows="3" class="form-control mb-3" maxlength="5000" required></textarea>
        <button type="submit" class="btn btn-primary">Share with community</button>
      </form>
    </div>
  </section>
  {% else %}
  <p>Join this community to publish a post. You can read its existing discussions below.</p>
  {% endif %}

  <h2 class="h4">Community discussions</h2>
  {% for post in posts %}
  <article class="card shadow-sm mb-3" id="community-post-{{ post.id }}">
    <div class="card-body">
      <a href="{{ url_for('user_profile', username=post.username) }}">@{{ post.username }}</a>
      <small class="text-muted ms-2">{{ post.created_at|datetimeformat }}</small>
      <p class="mt-2" style="white-space: pre-wrap;">{{ post.content }}</p>
      <a class="btn btn-sm btn-light" href="{{ url_for('post_detail', post_id=post.id) }}">Open discussion ({{ post.comment_count }} comments)</a>
    </div>
  </article>
  {% else %}
  <p>No posts on this page yet. {% if is_member %}Start the first discussion above.{% endif %}</p>
  {% endfor %}
  <nav aria-label="Community discussion pages" class="d-flex justify-content-center align-items-center my-4">
    {% if page > 1 %}<a class="btn btn-light" href="{{ url_for('assignment1.community_detail', community_id=community.id, page=page-1) }}">Previous</a>{% endif %}
    <span class="mx-3">Page {{ page }}</span>
    {% if has_next %}<a class="btn btn-light" href="{{ url_for('assignment1.community_detail', community_id=community.id, page=page+1) }}">Next</a>{% endif %}
  </nav>
</div>
{% endautoescape %}
{% endblock %}
