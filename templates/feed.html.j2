{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display %}

<div class="align-center text-center">
  <img src="{{ url_for('static', filename='icon.png') }}" alt="Logo" style="height: 64px;" class="mb-4">
</div>

{% if session.get('user_id') %}
<div class="col-md-8 mx-auto mb-4">
  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="card-title">Create a new post</h5>
      <form action="{{ url_for('add_post') }}" method="POST">
        <div class="mb-3">
          <textarea class="form-control" name="content" rows="3" placeholder="What's on your mind, {{ session.get('username') }}?" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary float-end">Post</button>
      </form>
    </div>
  </div>
</div>
{% endif %}

<!-- Chapter 2, Claim 15: frequent feedback makes a contribution goal useful. -->
{% if weekly_goal %}
<section class="col-md-8 mx-auto mb-4" id="weekly-goal" aria-labelledby="weekly-goal-heading">
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="h4" id="weekly-goal-heading">Your weekly goal</h2>
      <p class="text-muted">{{ weekly_goal.label }} · Helsinki time</p>
      <p>Comment on <strong>{{ weekly_goal.target }} different posts</strong> by other people this week. Share a useful thought or answer a question.</p>
      <p id="weekly-goal-count"><strong>{{ weekly_goal.completed }} / {{ weekly_goal.target }}</strong> conversations joined</p>
      <div class="progress mb-3" style="height: 20px;">
        <div class="progress-bar {% if weekly_goal.remaining == 0 %}bg-success{% endif %}"
             role="progressbar" style="width: {{ weekly_goal.percent }}%;"
             aria-label="Weekly goal progress" aria-valuenow="{{ weekly_goal.percent }}" aria-valuemin="0" aria-valuemax="100">
          {{ weekly_goal.percent }}%
        </div>
      </div>
      {% if weekly_goal.remaining == 0 %}
      <p class="text-success">Goal reached! Thank you for taking part in the conversations.</p>
      {% else %}
      <p>{{ weekly_goal.remaining }} more to reach your goal. Repeated comments on the same post count once.</p>
      <a class="btn btn-sm btn-primary mb-3" href="{{ url_for('feed', sort='needs_reply', show='all') }}">Find a conversation to join</a>
      {% endif %}
      <details>
        <summary>{% if weekly_goal.is_saved %}Change your goal{% else %}Choose your own target{% endif %}</summary>
        <form action="{{ url_for('assignment1.save_weekly_goal') }}" method="POST" class="mt-2">
          <label for="weekly-target" class="form-label">Different posts to comment on this week (1–50)</label>
          <input id="weekly-target" name="target" type="number" class="form-control mb-2" min="1" max="50" value="{{ weekly_goal.target }}" required>
          <button type="submit" class="btn btn-sm btn-primary">Save this week's goal</button>
        </form>
      </details>
      <p class="text-muted small mt-3 mb-0">Progress updates when this page loads. A new week starts on Monday at 00:00 in Helsinki, with a suggested target of three.</p>
    </div>
  </div>
</section>
{% endif %}

{% if session.get('user_id') %}
<section class="col-md-8 mx-auto mb-4" aria-labelledby="your-communities-heading">
  <h2 class="h5" id="your-communities-heading">Your communities</h2>
  {% for community in my_communities %}
    <a class="btn btn-light btn-sm me-2 mb-2" href="{{ url_for('assignment1.community_detail', community_id=community.id) }}">{{ community.name|e }} <span class="badge bg-success">Member</span></a>
  {% else %}
    <p>Join a community around a shared purpose and take part in its discussions.</p>
  {% endfor %}
  <a href="{{ url_for('assignment1.communities') }}">Explore communities</a>
</section>
{% endif %}

<!-- Chapter 2, Claim 1: make needed contributions visible and easy to act on. -->
{% if session.get('user_id') and current_sort != 'needs_reply' %}
<section class="col-md-8 mx-auto mb-4" aria-labelledby="needs-reply-heading">
  <div class="card shadow-sm border-primary">
    <div class="card-body">
      <h2 class="h4" id="needs-reply-heading">Needs a reply</h2>
      <p>Help someone start a conversation. These posts have no comments yet.</p>
      {% if current_show == 'following' %}
      <p class="text-muted small">Showing posts from people you follow.</p>
      {% endif %}
      {% for opportunity in needs_reply_posts %}
      <article class="border-top pt-3 mt-3" id="reply-opportunity-{{ opportunity.id }}">
        <a href="{{ url_for('user_profile', username=opportunity.username) }}">
          @{{ opportunity.username|e }}
        </a>
        <small class="text-muted ms-2">{{ opportunity.created_at|datetimeformat }}</small>
        <p class="mt-2">{{ opportunity.content|truncate(240, true)|e }}</p>
        <a href="{{ url_for('post_detail', post_id=opportunity.id) }}" class="btn btn-sm btn-light">Read full post</a>
        <!-- A native details element opens the reply form without custom JS. -->
        <details class="mt-2">
          <summary class="text-primary">Write the first reply</summary>
          <form action="{{ url_for('add_comment', post_id=opportunity.id) }}" method="POST" class="mt-2">
            <label for="first-reply-{{ opportunity.id }}" class="form-label">Your comment</label>
            <textarea id="first-reply-{{ opportunity.id }}" name="content" class="form-control mb-2" rows="2" required></textarea>
            <button type="submit" class="btn btn-primary btn-sm">Send reply</button>
          </form>
        </details>
      </article>
      {% else %}
      <p class="mb-0">No posts need their first reply in this view. Try the All filter or check back later.</p>
      {% endfor %}
      {% if needs_reply_count %}
      <a href="{{ url_for('feed', sort='needs_reply', show=current_show) }}" class="btn btn-light mt-3">
        View all {{ needs_reply_count }} posts needing a reply
      </a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<h2 class="text-center border-bottom pb-2 mb-4"><span>Posts</span></h2>

<div class="mb-4 text-center">

<!-- This is the 'sort' filter for New / Popular / Recommended -->
  <div class="btn-group me-5" role="group" aria-label="Sort posts">
    <!-- The link preserves the current_show state -->
    <a href="{{ url_for('feed', sort='new', show=current_show) }}" class="btn {% if current_sort == 'new' %}btn-primary{% else %}btn-light{% endif %}">New</a>
    <a href="{{ url_for('feed', sort='popular', show=current_show) }}" class="btn {% if current_sort == 'popular' %}btn-primary{% else %}btn-light{% endif %}">Popular</a>
    <a href="{{ url_for('feed', sort='recommended', show=current_show) }}" class="btn {% if current_sort == 'recommended' %}btn-primary{% else %}btn-light{% endif %}">Recommended</a>
    <a href="{{ url_for('feed', sort='needs_reply', show=current_show) }}" class="btn {% if current_sort == 'needs_reply' %}btn-primary{% else %}btn-light{% endif %}">Needs a reply ({{ needs_reply_count }})</a>
  </div>

  <!-- This is the 'show' filter for All / Following -->
  <!-- Following is only shown to logged in users -->
  {% if session.get('user_id') %}
  <div class="btn-group" role="group" aria-label="Filter posts">
    <!-- The link preserves the current_sort state -->
    <a href="{{ url_for('feed', sort=current_sort, show='all') }}" class="btn {% if current_show == 'all' %}btn-primary{% else %}btn-light{% endif %}">All</a>
    <a href="{{ url_for('feed', sort=current_sort, show='following') }}" class="btn {% if current_show == 'following' %}btn-primary{% else %}btn-light{% endif %}">Following</a>
  </div>
   {% endif %}

  
</div>

{% if current_sort == 'needs_reply' %}
<p class="col-md-8 mx-auto text-muted">These posts have no comments yet. Add a comment to start a conversation. Once a comment is added, the post leaves this list on the next page load.</p>
{% endif %}

<div class="col-md-8 mx-auto">
  {% for entry in posts %}
  <div class="card mb-4" id="post-{{ entry.post.id }}">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">
          {% if entry.followed_poster %}
          <a href="/u/{{ entry.post.user_id }}">{{ user_display(entry.post.username) }}<span class="text-success p-1" data-toggle="tooltip" data-placement="top" title="You are following this user"> ✓ </span>
</a>
          {% else %}
          <a href="/u/{{ entry.post.user_id }}">{{ user_display(entry.post.username) }} </a>
          {% endif %}
        </h3>

        
        {% if session.get('user_id') == entry.post.user_id %}
        <div class="d-flex align-items-center">
            <small class="text-muted me-3">{{ entry.post.created_at|datetimeformat }}</small>
            <form action="{{ url_for('delete_post', post_id=entry.post.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this post?');">
                <button type="submit" class="btn btn-danger" title="Delete Post">
                   delete
                </button>
            </form>
        </div>
        {% else %}
        <small class="text-muted">{{ entry.post.created_at|datetimeformat }}</small>
        {% endif %}
      </div>
      
      <p class="mt-2">{{ entry.post.content|e }}</p>

      <!-- Reactions Display and Add Reaction Button -->
      <div class="d-flex align-items-center mt-2 mb-2">
        <!-- Display existing reactions -->
        <div class="reactions-display me-2">
            {% if entry.reactions %}
              {% for react in entry.reactions %}
                {% if react.reaction_type == entry.user_reaction %}
                  <form action="{{ url_for('unreact') }}" method="post" class="d-inline">
                    <input type="hidden" name="post_id" value="{{ entry.post.id }}">
                    <button type="submit" class="btn btn-light text-dark me-1" title="{{ react.reaction_type|capitalize }}">
                      {{ reaction_emojis.get(react.reaction_type, '👍') }} {{ react.count }}
                    </button>
                  </form>
                {% else %}
                  <span class=" text-dark me-1" title="{{ react.reaction_type|capitalize }}">
                    {{ reaction_emojis.get(react.reaction_type, '👍') }} {{ react.count }}
                  </span>
                {% endif %}
              {% endfor %}
            {% else %}
              <span class="text-muted"> No reactions yet </span>
            {% endif %}
        </div>

        <!-- Add Reaction Dropdown Button -->
        {% if session.get('user_id') %}
        <div class="dropdown">
          <button class="btn btn-sm btn-light text-dark rounded-circle m-0" type="button" id="dropdownMenuButton-{{ entry.post.id }}" data-bs-toggle="dropdown" aria-expanded="false" title="Add Reaction" >
            +
          </button>
          <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-{{ entry.post.id }}">
            {% for reaction_type in reaction_types %}
            <li>
              <form action="{{ url_for('add_reaction') }}" method="POST" class="d-inline">
                <input type="hidden" name="post_id" value="{{ entry.post.id }}">
                <input type="hidden" name="reaction" value="{{ reaction_type }}">
                <button type="submit" class="dropdown-item">
                  {{ reaction_emojis.get(reaction_type, '👍') }} {{ reaction_type|capitalize }}
                </button>
              </form>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>


     {% if entry.comments %}
      <hr>
      {% if entry.comments %}
        <h6 class="mb-0">Comments ({{ entry.comments | count }})</h4>
      {% else %}
        <h6 class="mb-0">Comments</h4>
      {% endif %}
      <ul class="list-group list-group-flush shadow-none border-0">
        {% for comment in entry.comments[-2:] %}
        <li class="card shadow-none p-2 mt-2">
          <div class="d-flex justify-content-between">
            <div>
              <strong><a href="/u/{{ comment.username }}">{{ user_display(comment.username) }}</a></strong>
              <p class="mb-0">{{ comment.content|e }}</p>
            </div>
            
            {% if session.get('user_id') == comment.user_id or session.get('user_id') == entry.post.user_id %}
            <form action="{{ url_for('delete_comment', comment_id=comment.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                <button type="submit" class="btn btn-sm btn-danger" title="Delete Comment">delete</button>
            </form>
            {% endif %}

          </div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      <div class="d-flex justify-content-between mt-3">
        <a href="/posts/{{ entry.post.id }}" class="btn btn-sm btn-light show-comments-btn">
          Show all comments
        </a>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addCommentModal-{{ entry.post.id }}">Add Comment</button>
      </div>
    </div>
  </div>
  

  <div class="modal fade" id="addCommentModal-{{ entry.post.id }}" tabindex="-1" aria-labelledby="addCommentModalLabel-{{ entry.post.id }}" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addCommentModalLabel-{{ entry.post.id }}">Add a comment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form action="/posts/{{ entry.post.id }}/comment" method="POST">
            <div class="mb-3">
              <label for="comment-content-{{ entry.post.id }}" class="form-label">Your Comment</label>
              <textarea class="form-control" id="comment-content-{{ entry.post.id }}" name="content" rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Submit Comment</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  {% else %}
  {% if current_sort == 'needs_reply' %}
  <p class="text-center">No posts need their first reply on this page. Try the All filter or return to page 1.</p>
  {% else %}
  <p class="text-center">No posts to display.</p>
  {% endif %}
  {% endfor %}
</div>

  <div class="d-flex justify-content-center align-items-center my-4">
    <a href="{{ url_for('feed', page=page-1, sort=current_sort, show=current_show) }}"
      class="btn btn-primary {% if page <= 1 %}btn-light disabled{% endif %}">
      &laquo; Previous
    </a>
    <span class="mx-3 text-muted">Page {{ page }}</span>
    <a href="{{ url_for('feed', page=page+1, sort=current_sort, show=current_show) }}"
      class="btn btn-primary {% if (current_sort == 'needs_reply' and page * per_page >= needs_reply_count) or (current_sort != 'needs_reply' and posts|length < per_page) %}disabled{% endif %}">
      Next &raquo;
    </a>
  </div>
{% endblock %}
